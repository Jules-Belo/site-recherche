{
	"nodes":[
		{"id":"962780e103ebf6a9","type":"group","x":-780,"y":5200,"width":2372,"height":530,"label":"Variabilité du mouvement"},
		{"id":"4b1005cf48e3d949","type":"group","x":1260,"y":5380,"width":332,"height":260,"label":"Articles"},
		{
			"id":"622605d59414b13e",
			"type":"text",
			"text":"Lorsqu'une même tâche est répétée plusieurs fois, les schémas de mouvement ne sont jamais identiques et ne sont pas non plus d'un niveau d'excellence ",
			"styleAttributes":{
				"textAlign":null
			},
			"x":-100,
			"y":5590,
			"width":360,
			"height":120
		},
		{
			"id":"6e29717a366ada0f",
			"type":"text",
			"text":"**variabilité du mouvement** = un bruit perturbateur ",
			"styleAttributes":{},
			"x":-735,
			"y":5481,
			"width":290,
			"height":80
		},
		{
			"id":"6acd4cb4e742f518",
			"type":"text",
			"text":"Convient de le minimiser pour éviter toute déviation par rapport à un schéma de mouvement optimal.",
			"styleAttributes":{},
			"x":-760,
			"y":5601,
			"width":340,
			"height":100
		},
		{
			"id":"89f55147f307fac9",
			"type":"text",
			"text":"# Fitts & Posner",
			"styleAttributes":{"textAlign":"center","shape":"parallelogram"},
			"x":-720,
			"y":5321,
			"width":260,
			"height":60,
			"color":"5"
		},
		{
			"id":"73cacbbef3c48c66",
			"type":"text",
			"text":"### *Bartlett et al., 2007*",
			"styleAttributes":{},
			"x":-100,
			"y":5420,
			"width":237,
			"height":33
		},
		{
			"id":"295b2c7ee6707e8e",
			"type":"text",
			"text":"## Positionne la variabilité du mouvement comme ayant des propriétés fonctionnelles permettant l'adaptation aux contraintes changeantes ",
			"styleAttributes":{"textAlign":"center","shape":"pill"},
